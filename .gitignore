data/raw/
data/processed/
src/data/raw/
src/data/processed/
*.jpg
*.jpeg
*.png
*.webp
*.zip
*.tar.gz

# Si quieres versionar únicamente los CSV/JSON ligeros de metadatos y NO las imágenes,
# descomenta las 3 líneas de abajo:
# !src/data/splits/dataset_splits.csv
# !src/data/splits/dataset_metadata.json
# !src/data/processed/dataset_index.csv

